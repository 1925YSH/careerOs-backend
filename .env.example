NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/careeros

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=careeros_development_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=careeros_cookie_signing_secret_key_secure_32_chars

# AWS S3 Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_RESUME_BUCKET=careeros-resumes-dev

# AI LLM Provider
GEMINI_API_KEY=
OPENAI_API_KEY=

# Monetization & Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

